# Copy this file to ".env" and fill in your real values.

# Your MongoDB Atlas connection string.
# In Atlas: Database > Connect > Drivers > copy the string, then replace
# <username>, <password>, and add your database name (e.g. "todos") before the "?".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/todos?retryWrites=true&w=majority

# Port the server listens on (optional).
PORT=3000

# Secret used to sign login sessions. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Google login (optional). Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials and paste them here.
# Authorized redirect URI must be:  http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
